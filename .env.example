# Open http://127.0.0.1:8000 after running the documented start command.
FCN_DEMO_LOGIN=1
FCN_MARKET_MODE=fixture
FCN_DB=var/fcn.sqlite3
# For deployment use the runtime environment to provide a random stable secret.
FCN_SECRET_KEY=
FCN_SECURE_COOKIE=0
FCN_USERS_FILE=private/users.json
# Optional alternative for Render, containing the JSON password-hash map.
FCN_USERS_JSON=
# Live modes require explicit rate and dividend inputs from an approved source.
FCN_ASSUMPTIONS_FILE=private/assumptions.json
FCN_ASSUMPTIONS_JSON=
FCN_VENDOR_URL=
FCN_VENDOR_TOKEN=
# Longbridge OpenAPI legacy API key credentials (FCN_MARKET_MODE=longbridge).
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=
FCN_LONGBRIDGE_HK_REALTIME=0
LONGBRIDGE_PRINT_QUOTE_PACKAGES=false
# Set both to enable AI parsing. The form works independently.
OPENAI_API_KEY=
OPENAI_MODEL=
